<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.example</groupId>
        <artifactId>bs_lingxin</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>lingxin-server</artifactId>
    <name>lingxin-server</name>
    <description>启动模块：唯一可执行 jar，聚合全部业务模块</description>

    <dependencies>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>lingxin-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>lingxin-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>lingxin-module-system</artifactId>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>lingxin-module-member</artifactId>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>lingxin-module-product</artifactId>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>lingxin-module-trade</artifactId>
        </dependency>

        <!-- 数据库驱动只在此处引入，随 fat jar 一起交付 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 消息队列：业务代码暂未使用，保留能力 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>bs_lingxin</finalName>
        <plugins>
            <!-- 全工程只有这一个模块打可执行 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.example.bs_lingxin.BsLingxinApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
