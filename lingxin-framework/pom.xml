<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.example</groupId>
        <artifactId>bs_lingxin</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>lingxin-framework</artifactId>
    <name>lingxin-framework</name>
    <description>技术装配层：鉴权、密码加密、异步线程池</description>

    <dependencies>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>lingxin-common</artifactId>
        </dependency>
        <!-- BCrypt 密码加密（只用工具类，不启用 Security 的登录流程） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Sa-Token 鉴权 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
        </dependency>
        <!-- MybatisMetaObjectHandler 需要 MP 的 MetaObjectHandler 接口 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
