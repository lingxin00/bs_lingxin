# 【开发环境模板】
# 使用说明：复制本文件，重命名为 application-dev.yml，修改下面数据库、redis、mq账号密码
server:
  port: 8624

logging:
  level:
    root: info
    org.example.bs_lingxin.mapper: debug
    org.springframework: warn
  file:
    name: lingxin.log
  logback:
    rollingpolicy:
      max-file-size: 10MB
      max-history: 30
      total-size-cap: 1GB

spring:
  # MySQL数据源
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://127.0.0.1:3306/food_market?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false
    username: root
    password: 你的数据库密码

  data:
    # Redis配置
    redis:
      host: 127.0.0.1
      port: 6379
      password:
      database: 0
      connect-timeout: 3000ms

  # RabbitMQ配置
  rabbitmq:
    host: 127.0.0.1
    port: 5672
    username: guest
    password: guest
    virtual-host: /
    publisher-confirm-type: correlated
    publisher-returns: true
